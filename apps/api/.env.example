# 后端环境变量模板 —— 复制为 apps/api/.env

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- 至少配置一个模型 Provider ----
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_CHAT_MODEL=deepseek-chat
DEFAULT_AGENT_MODEL=deepseek-chat
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_RERANK_MODEL=bge-reranker-v2-m3

# ---- 存储 ----
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/sqlite/app.db
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

# ---- 实时 ----
REALTIME_BACKEND=sse

# ---- 音乐 ----
MUSIC_API_BASE_URL=http://localhost:3001

# ---- 安全 ----
ENABLE_SAFETY_FILTER=true
MEMORY_ENCRYPTION_KEY=change-me-please-32-chars-long!!

# 对话过程中自动抽取长期记忆（关掉后只能靠 /memory/ingest 手动写入）
MEMORY_AUTO_INGEST=true

# ---- 多媒体缓存 ----
# 启动时回收 uploads 里没有被任何消息引用的文件（传了没发出去的、会话被删掉的）
MEDIA_AUTO_CLEANUP=true
# 自动清理的宽限期（小时）：比这更新的文件不动，避免误删正在编辑的附件
MEDIA_CLEANUP_GRACE_HOURS=24
# 单张图片 / 单段音频大小上限（MB）
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25

# 硅基流动：用于云端 Embedding（如 BAAI/bge-m3），让记忆检索从字面匹配升级为语义匹配
# 注意它只提供 Embedding，不提供对话
SILICONFLOW_API_KEY=
