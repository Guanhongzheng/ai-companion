# 复制为 .env.local
# 注意：NEXT_PUBLIC_ 前缀的变量会被打包进浏览器，绝不要放任何密钥

NEXT_PUBLIC_APP_NAME=ai-companion
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 可选：Supabase Realtime（群聊多人实时同步）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 网易云音乐 API（NeteaseCloudMusicApi Enhanced）
# 启动方式：docker compose --profile infra up -d music-api
NEXT_PUBLIC_MUSIC_API_BASE_URL=http://localhost:3001
