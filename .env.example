# ============================================================
# ai-companion 环境变量模板
# 使用方法：复制为 .env（后端 apps/api）或 .env.local（前端 apps/web）
# 严禁把真实密钥提交到 GitHub —— .env* 已在 .gitignore 中排除
# ============================================================

# ------------------------------------------------------------
# 1. 运行环境
# ------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 2. 前端（apps/web/.env.local）
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=ai-companion
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 浏览器直连后端地址（SSE / fetch stream 都会走这里）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 可选：Supabase Realtime（实时社交对话）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 3. 后端（apps/api/.env）
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# 允许跨域的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# 4. 大模型 Provider（按需填，不用的留空）
# 统一经 LiteLLM 路由，命名遵循 <PROVIDER>_API_KEY 约定
# ------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# DeepSeek
DEEPSEEK_API_KEY=
# 阿里云通义千问（DashScope）
DASHSCOPE_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# 本地 Ollama（无需 key）
OLLAMA_BASE_URL=http://localhost:11434

# 默认模型：对话 / 编排 / embedding / rerank / 多模态
DEFAULT_CHAT_MODEL=deepseek-chat
DEFAULT_AGENT_MODEL=deepseek-chat
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_RERANK_MODEL=bge-reranker-v2-m3
DEFAULT_ASR_MODEL=whisper-1
DEFAULT_TTS_MODEL=

# 用户自带接口（BYOK）时后端是否允许透传用户 key
ALLOW_USER_PROVIDED_KEYS=true

# ------------------------------------------------------------
# 5. 向量库 / 数据库 / 对象存储
# ------------------------------------------------------------
VECTOR_STORE=chroma                # chroma | milvus_lite
CHROMA_PERSIST_DIR=./data/chroma
MILVUS_LITE_PATH=./data/milvus.db

DATABASE_URL=sqlite:///./data/sqlite/app.db
# 如需 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5432/ai_companion

STORAGE_BACKEND=local               # local | minio
LOCAL_STORAGE_DIR=./data/uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-companion
MINIO_SECURE=false

# ------------------------------------------------------------
# 6. 实时通信 / MCP
# ------------------------------------------------------------
REALTIME_BACKEND=sse                # sse | supabase | socketio
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=

# ------------------------------------------------------------
# 7. 音乐（NeteaseCloudMusicApi Enhanced）
# ------------------------------------------------------------
MUSIC_API_BASE_URL=http://localhost:3001
MUSIC_API_COOKIE=

# ------------------------------------------------------------
# 8. AI 安全与隐私
# ------------------------------------------------------------
# 敏感内容过滤开关
ENABLE_SAFETY_FILTER=true
# 记忆数据本地加密密钥（生产环境务必替换，32 位随机串）
MEMORY_ENCRYPTION_KEY=change-me-please-32-chars-long!!
# 用户数据保留天数（0 = 永久，直到用户手动删除）
DATA_RETENTION_DAYS=0
