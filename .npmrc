; ============================================================
; ai-companion · npm / pnpm 国内镜像配置
;
; 国内网络下走 npmmirror（淘宝源），速度通常是 npmjs.org 的 5-10 倍。
; 不在中国的同学，把下面 registry 注释掉即可回到官方源：
; ; registry=https://registry.npmjs.org/
; ============================================================

registry=https://registry.npmmirror.com/

; ---- 部分包的二进制文件不走 registry，需要单独指 CDN ----
; Next.js 的 SWC 编译器（性能关键）走 optionalDependencies，换源后会走国内 CDN
sharp_binary_host=https://registry.npmmirror.com/-/binary/sharp
sharp_libvips_binary_host=https://registry.npmmirror.com/-/binary/sharp-libvips
sentry_cli_binary_host=https://registry.npmmirror.com/-/binary/sentry-cli
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
node_sqlite3_binary_host_musl=https://registry.npmmirror.com/-/binary/sqlite3
canvas_binary_host_mirror=https://registry.npmmirror.com/-/binary/canvas
puppeteer_download_host=https://registry.npmmirror.com/-/binary/chrome-for-testing

; ---- 并发与下载策略 ----
; 提高并发，充分利用带宽
network-concurrency=32
child-concurrency=8
; 同一份依赖只下载一次，命中本地 store
resolution-mode=highest
; 安装进度更清晰
loglevel=info