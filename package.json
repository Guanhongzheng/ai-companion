{
  "name": "ai-companion",
  "version": "0.1.0",
  "private": true,
  "description": "个性化多模态 AI 伴侣与社交对话平台",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:music": "node scripts/dev-music.mjs",
    "build": "pnpm --filter @ai-companion/web build",
    "start": "pnpm --filter @ai-companion/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "pnpm -r exec rm -rf .next dist node_modules/.cache"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "pnpm": {
    "patchedDependencies": {
      "next@14.2.15": "patches/next@14.2.15.patch"
    }
  }
}
