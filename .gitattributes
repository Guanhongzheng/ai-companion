# 统一换行符策略：默认走 LF，避免 Windows 开发者提交 CRLF 造成整文件 diff
* text=auto eol=lf

# 明确文本类型
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做换行转换 + linguist 语言统计归类
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.mp3     binary
*.wav     binary
*.mp4     binary
*.webm    binary
*.pdf     binary
*.zip     binary

# 锁文件在语言统计里折叠
pnpm-lock.yaml   linguist-generated=true
